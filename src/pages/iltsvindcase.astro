---
import CaseLayout from "../layouts/CaseLayout.astro"
import CaseIntro from "../components/CaseIntro.astro"
import CaseGallari from "../components/CaseGallari.astro"
import FlexComponents from "../components/FlexComponents.astro"
import LinkKnap from "../components/LinkKnap.astro"
import FlexRev from "../components/FlexRev.astro"

import heroImg from "../assets/IltsvindIntro.webp"; 
import generator from "../assets/aabengenerator.png";
import IltsvindResearch from "../assets/iltsvindResearch.webp"
import IltsvindStil from "../assets/iltsvindStil.webp"
import iltsvindgami from "../assets/iltsvindgami.webp"
import formidling from "../assets/formidling.webp"
import feedback from "../assets/feedback.webp"
import iltsvindVideo from "../assets/Iltsvind.webm"

---

<CaseLayout title="Videnskab.dk Interactive Story">

  <main class="flex flex-col justify-center justify-items-center items-center gap-20 lg:gap-30 mb-20  w-full min-h-screen">

    <!-- Start Video -->
    <section class=" flex items-center mt-[15rem] w-[90%] sm:w-lg md:w-xl lg:w-[70%] xl:w-[60%] 2xl:w-[60%] 3xl:w-[60%] h-auto border-2 md:border-4 border-[#d17326]">
      <video src={iltsvindVideo} class="w-full h-auto block" autoplay muted loop playsinline></video>
    </section>
    

    <!-- Intro -->
    <CaseIntro >
      <img slot="intropic" src={heroImg.src} alt="">
      <h2 slot="introOverskrift" class="font-bold text-[#d17326] text-base sm:text-lg lg:text-lg xl:text-xl 2xl:text-2xl 3xl:text-3xl" >Videnskab.dk Interactive Story</h2>
      <p slot="introtekst" class="text-sm sm:text-base md:text-base lg:text-base xl:text-xl 2xl:text-xl 3xl:text-2xl"> Videnskab.dk is a digital platform for scientific information and education. <br> <br>

        For this project, I designed an interactive story about oxygen depletion in the ocean, intended for use in a dedicated teaching program in the subject Nature & Technology about the sea around Denmark.
         <br>
      </p>
       
      <h2 class="font-bold text-[#d17326] text-base sm:text-lg lg:text-md xl:text-lg 2xl:text-xl 3xl:text-2xl mt-15" >Objective</h2>
      <p class="text-sm sm:text-base md:text-base lg:text-base xl:text-xl 2xl:text-xl 3xl:text-2xl"> <b>After going through the interactive story, students should have a basic understanding of:</b> <br> <br>
        What threats oxygen depletion poses to the state of the ocean <br> How and why oxygen depletion occurs
        <br>What consequences oxygen depletion has for animals, people, and the planet
        <br>What individuals (or society) can do to help reduce oxygen depletion
</p>

        <LinkKnap class="mb-[7rem]" href="https://videnskabdk-iltsvind.netlify.app/">
            Prøv den interaktive historie
          </LinkKnap>
    
    </CaseIntro>
  
<!-- Research -->
<FlexRev>
      <img slot="flexRevBillede" src={IltsvindResearch.src} />
      <h2 slot="flexRevOverskrift" class="font-bold text-[#d17326] text-base sm:text-lg lg:text-lg xl:text-xl 2xl:text-2xl 3xl:text-3xl" >Research</h2>
      <p slot="flexRevTekst" class="text-sm sm:text-base md:text-base lg:text-base xl:text-xl 2xl:text-xl 3xl:text-2xl"> 
        As part of the research process, I explored the oxygen depletion issue in depth, along with the science behind it.
         I looked into which games the target audience already played, and I developed a target audience analysis to better understand their needs and preferences. <br> 
         The entire research process was essential for creating an interactive story that was both scientifically accurate and engaging for the target audience.
      </p>
</FlexRev>

<!-- Den visuelle stil -->
<section class="flex flex-col lg:flex-row items-center justify-center gap-15 lg:gap-10 w-[80%] 3xl:w-[70%] overflow-hidden ">
    <div class="w-[95%] sm:w-[70%]  lg:basis-[40%] 2xl:basis-[40%] 3xl:basis-[40%]">
        <img src={IltsvindStil.src} alt="Den Visuelle Stil">
    </div>
    <div class="w-[95%] sm:w-[80%] lg:basis-[60%] 2xl:basis-[50%] 3xl:basis-[40%] ">
        <h2 class="font-bold text-[#d17326] text-base sm:text-lg lg:text-lg xl:text-xl 2xl:text-2xl 3xl:text-3xl" >Visual Direction</h2>
        <p class="text-sm sm:text-base md:text-base lg:text-base xl:text-xl 2xl:text-xl 3xl:text-2xl mt-6">Visual Direction was developed with a focus on making complex academic content more accessible to the target audience, by letting text and illustrations support the same message..</p>

        <h4 class="font-semibold mt-2 text-base sm:text-lg lg:text-md xl:text-lg 2xl:text-xl 3xl:text-2xl">Keywords: Trustworthy, academic, Inspiring, universal</h4>

        <h3 class="font-semibold text-base sm:text-lg lg:text-md xl:text-lg 2xl:text-xl 3xl:text-2xl mt-6">Typography</h3>
        <p class="text-sm sm:text-base md:text-base lg:text-base xl:text-xl 2xl:text-xl 3xl:text-2xl">The typeface Chaloops was chosen for its soft and informal expression, which supports the project's visual universe. The font makes the academic content feel less heavy and more accessible to the target audience, while also contributing to a more engaging user experience.</p>
         <h3 class="font-semibold text-base sm:text-lg lg:text-md xl:text-lg 2xl:text-xl 3xl:text-2xl mt-6">Colors</h3> 
        <p class="text-sm sm:text-base md:text-base lg:text-base xl:text-xl 2xl:text-xl 3xl:text-2xl">The color palette consists primarily of blue, turquoise, and brown tones inspired by ocean and educational environments, creating cohesion, recognizability, and a trustworthy, science-based mood.</p>
    </div>
</section>

<!-- Gamification sektion -->
<section class="flex flex-col lg:flex-row-reverse items-center justify-center gap-15 lg:gap-10 w-[80%] 3xl:w-[70%] overflow-hidden ">
    <div class="w-[95%] sm:w-[70%]  lg:basis-[40%] 2xl:basis-[40%] 3xl:basis-[40%]">
        <img src={iltsvindgami.src} alt="">
    </div>
    <div class="w-[95%] sm:w-[80%] lg:basis-[60%] 2xl:basis-[50%] 3xl:basis-[40%] ">
        <h2 class="font-bold text-[#d17326] text-base sm:text-lg lg:text-lg xl:text-xl 2xl:text-2xl 3xl:text-3xl" >Gamification</h2>
        <p class="text-sm sm:text-base md:text-base lg:text-base xl:text-xl 2xl:text-xl 3xl:text-2xl">The project uses gamification to make learning about oxygen depletion more engaging for students in grades 4-6. Through choices, consequences, and badges, the user experiences the story as an interactive mission where their actions affect the state of the ocean. This strengthens motivation, reflection, and understanding of complex issues.
        </p>
    </div>
</section>

<!-- Formidling og Feedback sektion -->
<section class=" h-auto  flex flex-col items-center gap-10 w-[80%] 3xl:w-[70%] overflow-hidden">
   <div class=" w-[90%] sm:w-lg md:w-xl lg:w-[70%] xl:w-[60%] 2xl:w-[60%] 3xl:w-[60%] z-10">
    <img src={formidling.src} alt="Formidling"> 
  </div>
  <div class=" w-[90%] sm:w-lg md:w-xl lg:w-[70%] xl:w-[60%] 2xl:w-[60%] 3xl:w-[60%] z-10">
    <img src={feedback.src} alt="Feedback">
  </div>
</section>

<div id="video" class="hidden 2xl:flex justify-center w-[80%] h-[42rem] mb-[25rem]">
  <iframe
    title="Iltsvind Interaktiv Historie embeded"
     width="2320"
    height="990"
    src="https://videnskabdk-iltsvind.netlify.app/">
  </iframe>
</div>

    

  </main>
</CaseLayout>