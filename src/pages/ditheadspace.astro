---
import CaseLayout from "../layouts/CaseLayout.astro"
import CaseIntro from "../components/CaseIntro.astro"
import CaseGallari from "../components/CaseGallari.astro"
import FlexComponents from "../components/FlexComponents.astro"

import FlexRev from "../components/FlexRev.astro"
---

<CaseLayout title="Dit headspace">

  <main class="flex flex-col items-center gap-20 lg:gap-30 mb-20  w-full min-h-screen ">
    <section class="mt-[15rem] w-full flex items-center justify-center">
      <CaseIntro >
            <img slot="intropic" src="headspaceIntro.webp" alt="">
            <h2 slot="introOverskrift" class="font-bold text-[#d17326] text-base sm:text-lg lg:text-lg xl:text-xl 2xl:text-2xl 3xl:text-3xl" >Dit headspace</h2>
            <p slot="introtekst" class="text-sm sm:text-base md:text-base lg:text-base xl:text-xl 2xl:text-xl 3xl:text-2xl"> Dit Headspace er et pixelart-spil designet til unge mellem 12-25 år, udviklet som en kampagne for headspace Danmark. <br> <br>Gennem en legende tilgang hjælper spillet brugeren med at identificere og navngive det de bærer på mentalt. Spillet giver dem konkrete redskaber til at handle på det.
            </p>
             
      
    </CaseIntro> </section>

   

    <section  class=" sm:w-[65%] xl:w-[60%] 2xl:w-[50%] 3xl:w-[45%] w-[80%] self-center flex flex-col  justify-center gap-4">
        <img src="/gameTroguh.webp" class=" w-full h-auto max-w-full" alt="Billede af spillet" />
        <p class="text-sm sm:text-base md:text-base lg:text-base xl:text-xl 2xl:text-xl 3xl:text-2xl"> Spillet er udviklet i Unity. Her ses en gennemgang af de centrale skærmbilleder fra prototypen. Fra første møde med spillet til worry jar-questen.</p>
    </section>

    <!-- Problem -->

    <FlexComponents>
      <img slot="flexBillede" src="/problem.png" />
      <h2 slot="flexOverskrift" class="font-bold text-[#d17326] text-base sm:text-lg lg:text-lg xl:text-xl 2xl:text-2xl 3xl:text-3xl" >Problemstilling</h2>
      <p slot="flexTekst" class="text-sm sm:text-base md:text-base lg:text-base xl:text-xl 2xl:text-xl 3xl:text-2xl"> Flere unge oplever udfordringer med deres mentale sundhed. Det kan være svært at vide hvor man skal starte, eller overhovedet at vide at man kan få hjælp. <br> <br>

      Headspace Danmark tilbyder gratis og anonym rådgivning til unge mellem 12-25 år, men når ikke dem der endnu ikke har taget det første skridt. <br><br>
        Opgaven var at ændre på det. Gennem en digital oplevelse der forebygger, afhjælper og giver de unge konkrete redskaber til at handle. 
      </p>
</FlexComponents>


<section class="flex flex-col lg:flex-row-reverse items-center justify-center gap-15 lg:gap-10 w-[80%] 3xl:w-[70%] overflow-hidden ">
    <div class="w-[95%] sm:w-[70%]  lg:basis-[40%] 2xl:basis-[40%] 3xl:basis-[40%]">
        <video class=" border-2 md:border-8 border-[#d17326] w-[65%] ml-[3.5rem] lg:ml-[7rem] " autoplay muted src="/headspaceVideo.mp4" />
    </div>
    <div class="w-[95%] sm:w-[80%] lg:basis-[60%] 2xl:basis-[50%] 3xl:basis-[40%] ">
        <h2  class="font-bold text-[#d17326] text-base sm:text-lg lg:text-lg xl:text-xl 2xl:text-2xl 3xl:text-3xl" >Løsningen</h2>
        <p  class="text-sm sm:text-base md:text-base lg:text-base xl:text-xl 2xl:text-xl 3xl:text-2xl"> 
        Spillet møder brugeren der hvor de er. Spillet er kort, tilgængeligt og uden lange onboardings. Inspireret af ideen om Instagram-spil der kan spilles som reels. Det er det designet til den platform målgruppen allerede bruger. </h4>
      </p>
      <div class="w-full flex items-center justify-center mt-[4rem]">
         <img class="w-[35%]" src="/mockupReel.png" alt="">
      </div>


    </div>
</section>


<!-- Karakteren Kiko -->
<section class="flex flex-col-reverse lg:flex-row-reverse items-center justify-center  lg:gap-10 w-[80%] 3xl:w-[70%] overflow-hidden mt-[4rem] ">
    
    <div class="flex flex-col-reverse lg:flex-col  w-[95%] sm:w-[80%] lg:basis-[60%] 2xl:basis-[50%] 3xl:basis-[40%] h-auto gap-[2rem] lg:gap-0 ">
        <div>
        <h2  class="font-bold text-[#d17326] text-base sm:text-lg lg:text-lg xl:text-xl 2xl:text-2xl 3xl:text-3xl" >Karakteren Kiko</h2>
        <p  class="text-sm sm:text-base md:text-base lg:text-base xl:text-xl 2xl:text-xl 3xl:text-2xl"> 
        Kiko er en lemur og spillerens følgesvend. Et dyr frem for en menneskelig figur, fordi det kan være nemmere at åbne op overfor nogen der ikke kan dømme dig. </h4>
      </p> </div>
      <div class="w-full flex items-center justify-center mt-[4rem]">
         <img class=" sm:w-[70%] lg:w-[50%]" src="/kikoSet.png" alt="">
      </div>
    </div>
    <div class="flex items-center justify-center w-[95%] sm:w-[70%]  lg:basis-[40%] 2xl:basis-[40%] 3xl:basis-[40%]">
        <img class="w-[60%]" src="/kikoBig.svg" alt="">
    </div>
</section>

<!-- Game mechanics -->
<section class="flex flex-col lg:flex-row-reverse items-center justify-center gap-15 lg:gap-10 w-[80%] 3xl:w-[70%] overflow-hidden ">
    <div class="w-[95%] sm:w-[70%]  lg:basis-[40%] 2xl:basis-[40%] 3xl:basis-[40%]">
        <img src="/GameMac.png" alt="">
    </div>
    <div class="w-[95%] sm:w-[80%] lg:basis-[60%] 2xl:basis-[50%] 3xl:basis-[40%] ">
        <h2  class="font-bold text-[#d17326] text-base sm:text-lg lg:text-lg xl:text-xl 2xl:text-2xl 3xl:text-3xl" >Game mechanics</h2>
        <p  class="text-sm sm:text-base md:text-base lg:text-base xl:text-xl 2xl:text-xl 3xl:text-2xl"> 
        Der er fire centrale mekanikker.</p>

        <h3 class="font-semibold text-base sm:text-lg lg:text-md xl:text-lg 2xl:text-xl 3xl:text-2xl mt-6">Den mentale rygsæk</h3>
        <p class="text-sm sm:text-base md:text-base lg:text-base xl:text-xl 2xl:text-xl 3xl:text-2xl">Rygsækkens vægt visualiserer spillerens mentale belastning. Den reduceres, når spilleren gennemfører quests og arbejder med sin mentale trivsel. </p>

        <h3 class="font-semibold text-base sm:text-lg lg:text-md xl:text-lg 2xl:text-xl 3xl:text-2xl mt-6">Guided open world</h3>
        <p class="text-sm sm:text-base md:text-base lg:text-base xl:text-xl 2xl:text-xl 3xl:text-2xl">Et pixelart-bykort giver spilleren frihed til selv at vælge, hvilke quests de vil besøge og i hvilken rækkefølge. </p>

        <h3 class="font-semibold text-base sm:text-lg lg:text-md xl:text-lg 2xl:text-xl 3xl:text-2xl mt-6">Questene</h3>
        <p class="text-sm sm:text-base md:text-base lg:text-base xl:text-xl 2xl:text-xl 3xl:text-2xl">Quests er spillets kerne og omsætter mental trivsel til konkrete handlinger frem for traditionelle spørgeskemaer og refleksionsøvelser.</p>

        <h3 class="font-semibold text-base sm:text-lg lg:text-md xl:text-lg 2xl:text-xl 3xl:text-2xl mt-6">Alderstilpasning</h3>
        <p class="text-sm sm:text-base md:text-base lg:text-base xl:text-xl 2xl:text-xl 3xl:text-2xl">Spillet tilpasser automatisk sprog, Kikos tone, quests og bagagekategorier til spillerens aldersgruppe: 12–15, 16–19 eller 20–25 år.</p>

    </div>
</section>

<!-- Den visuelle stil -->
<section class="flex flex-col lg:flex-row items-center justify-center gap-15 lg:gap-10 w-[80%] 3xl:w-[70%] overflow-hidden ">
    <div class="w-[95%] sm:w-[70%]  lg:basis-[40%] 2xl:basis-[40%] 3xl:basis-[30%]">
        <img src="/Spilvisuel.webp" alt="Den Visuelle Stil">
    </div>
    <div class="w-[95%] sm:w-[80%] lg:basis-[60%] 2xl:basis-[50%] 3xl:basis-[40%] ">
        <h2 class="font-bold text-[#d17326] text-base sm:text-lg lg:text-lg xl:text-xl 2xl:text-2xl 3xl:text-3xl" >Den Visuelle Stil</h2>
        <h4 class="font-semibold text-base sm:text-lg lg:text-md xl:text-lg 2xl:text-xl 3xl:text-2xl">Pixelart stil</h4>
        <p class="text-sm sm:text-base md:text-base lg:text-base xl:text-xl 2xl:text-xl 3xl:text-2xl mt-6">Spillet bruger en pixelart-stil inspireret af klassiske mobilspil og tidlige konsolspil. Stilen er bevidst valgt frem for en klinisk eller poleret æstetik fordi:</p>
        
        <p class="text-sm sm:text-base md:text-base lg:text-base xl:text-xl 2xl:text-xl 3xl:text-2xl mt-[2rem] lg:mt-[4rem]">Den skaber <b>psykologisk distance.</b>  Det kan være lettere at fortælle om svære følelser over for en lille pixelfigur end på et realistisk interface</p>
        
        <p class="text-sm sm:text-base md:text-base lg:text-base xl:text-xl 2xl:text-xl 3xl:text-2xl mt-[1rem] lg:mt-[2rem]">Den er <b>ikke-intimiderende.</b>  Pixelart signalerer leg, ikke præstation. Der er ikken nogle rigtige svar der er ikke noget spilleren kan gøre forkert.</p>

        <p class="text-sm sm:text-base md:text-base lg:text-base xl:text-xl 2xl:text-xl 3xl:text-2xl mt-[1rem] lg:mt-[2rem]">Den er <b>genkendelig for målgruppen. </b> Det er nostalgisk for de ældre og naturlig for de yngre som kender Minecraft, Roblox, Pokemon osv.</p>



        <div class="w-full flex items-center justify-center mt-[3rem] lg:mt-[6rem]">
            <img class=" sm:w-[70%] lg:w-[60%]" src="/sweetspot.png" alt="">
        </div>
    </div>
</section>



    </main>
</CaseLayout>
