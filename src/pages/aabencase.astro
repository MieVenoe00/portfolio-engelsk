---
import CaseLayout from "../layouts/CaseLayout.astro"
import CaseIntro from "../components/CaseIntro.astro"
import CaseGallari from "../components/CaseGallari.astro"
import FlexComponents from "../components/FlexComponents.astro"
import LinkKnap from "../components/LinkKnap.astro"

import heroImg from "../assets/aabenbillederorange.webp";
import pictureEt from "../assets/labelbillede1.webp";
import pictureTo from "../assets/labelbillede2.webp";
import generator from "../assets/aabengenerator.webp";

---

<CaseLayout title="ÅBEN Brewery">

  <main class="flex flex-col items-center gap-20 lg:gap-30 mb-20  w-full min-h-screen ">
    <section class="mt-[15rem] w-full flex items-center justify-center">
      <CaseIntro >
            <img slot="intropic" src={heroImg.src} alt="">
            <h2 slot="introOverskrift" class="font-bold text-[#d17326] text-base sm:text-lg lg:text-lg xl:text-xl 2xl:text-2xl 3xl:text-3xl" >ÅBEN Brewery Label Generator</h2>
            <p slot="introtekst" class="text-sm sm:text-base md:text-base lg:text-base xl:text-xl 2xl:text-xl 3xl:text-2xl"> ÅBEN is a Danish craft brewery with a strong focus on experimental beers and frequent releases, creating a need for fast and consistent production of visual material. <br> <br>

              For this project, I designed and coded a generative label tool in p5.js, where the beer's own flavor notes automatically drive the label's colors through a data-driven gradient system. <br>
            </p>
              <LinkKnap  href="https://aben-beer-label.netlify.app/">
                Try it out 
              </LinkKnap></div>
      
    </CaseIntro> </section>
  
      <CaseGallari>
        <img slot="picture1" src={pictureEt.src} />
        <img slot="picture2" src={pictureTo.src} />
    </CaseGallari>

<FlexComponents>
      <img slot="flexBillede" src={generator.src} />
      <h2 slot="flexOverskrift" class="font-bold text-[#d17326] text-base sm:text-lg lg:text-lg xl:text-xl 2xl:text-2xl 3xl:text-3xl" >The Label Generator</h2>
      <p slot="flexTekst" class="text-sm sm:text-base md:text-base lg:text-base xl:text-xl 2xl:text-xl 3xl:text-2xl"> The generator creates organic, noise-distorted shapes, while the designer still retains creative control over composition and rhythm via intuitive sliders. <br>
        The beer style also automatically influences theme, contrast, and blend modes, allowing the design to adapt to the character of each beer without losing ÅBEN's visual identity. <br><br>

        Theis solution makes it possible to quickly produce unique labels for an ever-growing catalog of beers, while keeping the design process consistent and user-friendly. 
      </p>
</FlexComponents>

<div class="flex flex-col items-center content-center w-[80%] gap-4">
  <p class="self-center text-sm xl:hidden">*Denne generator er lavet til desktop, da dette var kundens behov</p>
  
  <div class="w-full h-[50rem] overflow-hidden relative">
    <iframe
      title="Inline Frame Example"
      class="absolute top-0 left-0"
      style="transform: scale(0.7); transform-origin: top left; width: calc(100% / 0.7); height: calc(71.4rem);"
      src="https://aben-beer-label.netlify.app/">
    </iframe>
  </div>
</div>

    

  </main>
</CaseLayout>