---
import Layout from "../layouts/Layout.astro";
import kolnAnimation from '../data/kolnanimationshero.json';

import CaseLayout from "../layouts/CaseLayout.astro"
import CaseIntro from "../components/CaseIntro.astro"
import CaseGallari from "../components/CaseGallari.astro"
import FlexComponents from "../components/FlexComponents.astro"
import LinkKnap from "../components/LinkKnap.astro"
import FlexRev from "../components/FlexRev.astro"
import heroImgkoln from "../assets/topkolnpics.webp";
import kolnresearch  from "../assets/kolnmonster.webp"
import monstercheet from "../assets/monsterCheet.png"
import logostack from "../assets/logostack.jpg"
import logostacksmall from "../assets/logostacksmall.jpg"
import kolnendpics from "../assets/kolnbottompic.webp"
---


<CaseLayout title="Köln / Cologne - Tyskland">

  <main class="flex flex-col justify-center justify-items-center items-center gap-20 lg:gap-30 mb-20  w-full min-h-screen">

    <!-- Start Video -->
    <section class=" flex items-center mt-[15rem] w-[90%] sm:w-lg md:w-xl lg:w-[70%] xl:w-[60%] 2xl:w-[60%] 3xl:w-[60%] h-auto border-2 md:border-4 border-[#d17326]">
      <div id="koln-hero-animation"></div>
    </section>
    

    <!-- Intro -->
    <CaseIntro>
      <img slot="intropic" src={heroImgkoln.src} alt="">
      <h2 slot="introOverskrift" class="font-bold text-[#d17326] text-base sm:text-lg lg:text-lg xl:text-xl 2xl:text-2xl 3xl:text-3xl" >Köln / Cologne Dynamic Visual Identity</h2>
      <p slot="introtekst" class="text-sm sm:text-base md:text-base lg:text-base xl:text-xl 2xl:text-xl 3xl:text-2xl"> <b>How can a city's identity be in constant motion? </b> <br> <br>
        For this case, I developed a dynamic visual identity for Cologne based on coding and generative design. The project took its starting point in Cologne's iconic cathedral and all its patterns, which were translated into a visual design system for its logo and graphic foundation.
      </p>
  
    </CaseIntro>
  
    <!-- Research -->
    <section class="flex flex-col lg:flex-row-reverse items-center justify-center gap-15 lg:gap-10 w-[80%] 3xl:w-[70%] overflow-hidden ">
    <div class="w-[60%] sm:w-[50%]  lg:basis-[18%] 2xl:basis-[15%] 3xl:basis-[22%]">
        <img src={kolnresearch.src} />
    </div>
    <div class=" flex flex-col w-[95%] sm:w-[80%] lg:basis-[60%] 2xl:basis-[50%] 3xl:basis-[40%] ">
        <h2 class="font-bold text-[#d17326] text-base sm:text-lg lg:text-lg xl:text-xl 2xl:text-2xl 3xl:text-3xl" >Pattern-Based Design</h2>
        <p  class="text-sm sm:text-base md:text-base lg:text-base xl:text-xl 2xl:text-xl 3xl:text-2xl"> 
            The design system is based on geometric patterns from Cologne Cathedral, and the color palette is inspired by the cathedral's stained-glass windows. <br> <br>
            The system was developed as the foundation for a generative generator, where coding can create new visual expressions based on the same design rules. <br> <br>
            The concept shows how a set of rules and coding can form the basis for a dynamic visual identity that can evolve and be applied across branding and communication on different media.
          </p>
          <div class=" flex justify-center w-full pt-10  ">
            <img class="w-[95%] sm:w-[90%]  lg:basis-[90%] 2xl:w-[85%] 3xl:w-full" src={monstercheet.src} />
        </div>
    </div>
  </section>

  <section class="flex flex-col  items-center justify-center gap-15 lg:gap-10 mt-10 w-[65%] 3xl:w-[65%]  overflow-hidden">
    <div class="flex flex-col items-center w-auto" >
      <img class=" border-2 md:border-4 border-[#d17326] w-full" src={logostack.src} />
      <img class=" border-2 md:border-4 border-[#d17326] mt-8 w-[69%]" src={logostacksmall.src} />
    </div>
    <div class=" flex flex-col justify-center w-[95%] 3xl:w-[65%]  ">
      <h2 class="font-bold text-[#d17326] text-base sm:text-lg lg:text-lg xl:text-xl 2xl:text-2xl 3xl:text-3xl" >Logo Generator</h2>
        <p  class="text-sm sm:text-base md:text-base lg:text-base xl:text-xl 2xl:text-xl 3xl:text-2xl"> 
            The logo generator is able to continuously generate new logos where the patterns within the logo change. The algorithm follows different rules, such as ensuring that two identical colors aren't placed too close to each other, and there is variation between circles and squares. <br> <br>
            In the long run, this design system could be scaled up, and a generator could be developed where these patterns can be used across different platforms and media. 
          </p>
          <div class="relative w-full overflow-hidden mt-15 " style="height: 33rem;">
            <iframe
              title="Inline Frame Example"
              class="absolute top-0 left-0"
              style="width: 1400px; height: 1200px; transform: scale(0.7); transform-origin: top left;"
              src="https://kolngenerator.netlify.app/">
            </iframe>
            
          </div> 
          <p class="text-xs text-mauve-400">*Made in collaboration with Claude</p>
    </div>
    <div class="w-[55%] 3xl:w-[50%] mt-20 ">
        <img src={kolnendpics.src} />
    </div>
  </section>






    

  </main>
</CaseLayout>

<script>
  import lottie from 'lottie-web';
  import animationData from '../data/kolnanimationshero.json';


  // Find asset med id "6"
const asset6 = animationData.assets.find(a => a.id === '6');
const layer0 = asset6.layers.find(l => l.ind === 0);

// Fjern den shape-gruppe der har fill-farven [0.1, 0.09, 0.11, 1]
layer0.shapes = layer0.shapes.filter(shape => {
  const fill = shape.it?.find(item => item.ty === 'fl');
  if (fill && fill.c.k[0] === 0.1 && fill.c.k[1] === 0.09 && fill.c.k[2] === 0.11) {
    return false; // fjern denne gruppe
  }
  return true;
});

lottie.loadAnimation({
  container: document.getElementById('koln-hero-animation')!,
  renderer: 'svg',
  loop: true,
  autoplay: true,
  animationData: animationData
});
</script>