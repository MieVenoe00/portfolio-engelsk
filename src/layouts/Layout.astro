---
import '../styles/global.css';
import { readFileSync } from 'fs';
import { resolve } from 'path';

const navmenu = readFileSync(resolve('public/navmenu.svg'), 'utf-8');
const { title } = Astro.props;
---


<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favikon.svg" />
    <link rel="icon" href="/favicon.svg" />
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:ital,wght@0,100..700;1,100..700&display=swap" rel="stylesheet">
    <meta name="generator" content={Astro.generator} />
    <title>Mie Venø Skjærbæk //{title}</title>   
  </head>
  <body>
    <header class="fixed top-8 left-6 sm:left-10 z-10">
      <a href="/">
        <h1 id="headOverskrift" class="text-[#d17326] text-2xl sm:text-3xl md:text-3xl lg:text-3xl xl:text-3xl 2xl:text-4xl font-bold">Mie Venø Skjærbæk</h1>
      </a>
      <p id="sideTag" class="text-[#d17326] text-xl sm:text-xl md:text-2xl lg:text-2xl xl:text-2xl 2xl:text-3xl">//{title}</p>
    </header>
    <nav class="fixed top-8 right-6 sm:right-10 z-50 w-[14%] sm:w-[12%] md:w-[12%] lg:w-[7%] xl:w-[6%] 2xl:w-[5%]">
        <div class="w-full [&>svg]:w-full [&>svg]:h-auto"  set:html={navmenu} />
    </nav>
    <slot />
  </body>
  <script>
     document.getElementById('homebtn')?.addEventListener('click', () => {
    window.location.href = '/';
      });
     document.getElementById('casesbtn')?.addEventListener('click', () => {
    window.location.href = '/cases';
      });
    document.getElementById('contactbtn')?.addEventListener('click', () => {
      window.location.href = '/contact';
      });
    document.getElementById('aboutbtn')?.addEventListener('click', () => {
      window.location.href = '/about';
      });

     const nav = document.querySelector('nav');
const slides = {
  'slide-home': -60, 
  'slide-cases': -60,   // px op mod menubtn
  'slide-contact': -60,
  'slide-about': -60,
};

// Start stacked under menubtn
Object.entries(slides).forEach(([id, offset]) => {
  const el = document.getElementById(id);
  if (el) el.style.transform = `translateY(${offset}px)`;
});

nav.addEventListener('mouseenter', () => {
  Object.keys(slides).forEach(id => {
    const el = document.getElementById(id);
    if (el) {
      el.style.transition = 'transform 0.4s ease';
      el.style.transform = 'translateY(0px)';
    }
  });
});

nav.addEventListener('mouseleave', () => {
  Object.entries(slides).forEach(([id, offset]) => {
    const el = document.getElementById(id);
    if (el) {
      el.style.transition = 'transform 0.4s ease';
      el.style.transform = `translateY(${offset}px)`;
    }
  });
});


  </script>
</html>

